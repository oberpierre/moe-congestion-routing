# Patch: MoE routing metrics (load-balance battery + SwapGap + phi_cong), and data-driven track_names
# ==================================
# Problem: Megatron logs only the aux/z-loss. Three more things are needed: the load-balance
#   battery the arms are compared on, SwapGap (how far the router is from a Nash equilibrium under
#   congestion pricing, 0 meaning one-swap-stable, needing no equilibrium solve), and the discrete
#   Rosenthal congestion potential phi_cong, which is computable for every arm regardless of what
#   it trains against and is what the Exp 3 cross-arm plot needs. All three are functionals of the
#   router's logits and routing_map, both already available at the end of routing(). Separately,
#   the training.py hunk used to append ten literal metric names to track_names, so every new
#   logged metric required editing this vendored file.
#
# What this patch does:
#   - router.py: TopKRouter.routing() records, via the existing MoE metrics tracker,
#       _record_load_balance_metrics(): load CV, MaxVio, Hill 0/1/2 D, ||f-p||_1, dead experts.
#       _record_swapgap(): per-layer SwapGap, computed by moe_congestion_routing.metrics.swapgap,
#         which owns the pricing convention and the admissibility rule fixing the price set.
#       _record_phi_cong(): per-layer discrete congestion potential, computed by
#         moe_congestion_routing.losses.rosenthal.congestion_potential. Fixed at lambda=1, which
#         is NOT a quadratic arm's trained lambda -- see the method's own docstring.
#   - training.py: replaces the literal track_names list with `track_names += moe_track_names(args)`
#     from moe_congestion_routing.metrics.track_names. Adding a logged MoE metric is now a change
#     to that module, not to this vendored file.
#   All three ride --moe-per-layer-logging: the layer mean is always recorded, per-layer series
#   only when the flag is set.
#
# Where in the code:
#   File: megatron/core/transformer/moe/router.py
#   Function: TopKRouter.routing() / _record_load_balance_metrics() / _record_swapgap() /
#     _record_phi_cong()
#   Location: end of routing(), after expert-bias selection.
#
#   File: megatron/training/training.py
#   Function: training_log()
#   Location: the MoE track_names block (~line 2549), beside the aux/z-loss names.
#
# How to fix if this patch breaks on a future Megatron version:
#   Search for `_apply_expert_bias` in moe/router.py; add the three record calls + methods after
#   it, passing the router's logits and routing_map. Search for `args.moe_z_loss_coeff` in
#   training.py; replace/re-add the `track_names += moe_track_names(args)` line there.
#
# Applied to: Megatron-LM core_v0.18.0
#
diff --git a/megatron/core/transformer/moe/router.py b/megatron/core/transformer/moe/router.py
index 235a616df..9444a8c7a 100644
--- a/megatron/core/transformer/moe/router.py
+++ b/megatron/core/transformer/moe/router.py
@@ -669,8 +669,120 @@ class TopKRouter(Router):
         # Optionally apply expert bias
         self._apply_expert_bias(routing_map, padding_mask=padding_mask)
 
+        # Load-balance metrics battery (moe-congestion-routing patch).
+        self._record_load_balance_metrics(logits, routing_map)
+
+        # SwapGap equilibrium-gap battery (moe-congestion-routing patch).
+        self._record_swapgap(logits, routing_map)
+
+        # Discrete congestion potential (moe-congestion-routing patch).
+        self._record_phi_cong(routing_map)
+
         return probs, routing_map
 
+    def _record_load_balance_metrics(self, logits: torch.Tensor, routing_map: torch.Tensor):
+        """Record the per-step load-balance battery via the MoE metrics tracker."""
+        if not (self.training and torch.is_grad_enabled()):
+            return
+        with torch.no_grad():
+            num_experts = routing_map.shape[-1]
+            num_tokens = routing_map.shape[0]
+            if num_tokens == 0:
+                return
+            topk = self.topk
+            balanced_load = num_tokens * topk / num_experts
+
+            tokens_per_expert = routing_map.sum(dim=0).float()  # hard load n_e, [E]
+            share = tokens_per_expert / (num_tokens * topk)  # mu_e, distribution over experts
+            mean_prob = torch.softmax(logits.float(), dim=-1).mean(dim=0)  # soft load p_e
+
+            load_cv = tokens_per_expert.std(unbiased=False) / (tokens_per_expert.mean() + 1e-9)
+            maxvio = (tokens_per_expert.max() - balanced_load) / balanced_load
+            n_eff_0 = (tokens_per_expert > 0).sum().float()
+            safe = share.clamp_min(1e-12)
+            n_eff_1 = (-(safe * safe.log()).sum()).exp()
+            n_eff_2 = 1.0 / (share.pow(2).sum() + 1e-12)
+            frac_gate_l1 = (share - mean_prob).abs().sum()
+            dead_experts = (share < 0.1 / num_experts).sum().float()
+
+        num_layers = self.config.num_layers
+        for name, value in (
+            ("load_cv", load_cv),
+            ("maxvio", maxvio),
+            ("n_eff_0", n_eff_0),
+            ("n_eff_1", n_eff_1),
+            ("n_eff_2", n_eff_2),
+            ("frac_gate_l1", frac_gate_l1),
+            ("dead_experts", dead_experts),
+        ):
+            get_moe_metrics_tracker().record(name, value, self.layer_number, num_layers)
+
+    def _record_swapgap(self, logits: torch.Tensor, routing_map: torch.Tensor):
+        """Record per-layer SwapGap (equilibrium gap) for each admitted measurement price.
+
+        The loop iterates SWAPGAP_COSTS rather than the trainable cost registry, because not
+        every cost an arm may train against is valid to measure a gap at. The admitted set is
+        deliberately not restated here as a literal list; read it and the reason from
+        moe_congestion_routing.metrics.swapgap. Rides --moe-per-layer-logging like the rest of
+        the battery.
+        """
+        if not (self.training and torch.is_grad_enabled()):
+            return
+        if routing_map.shape[0] == 0:
+            return
+        # Local import: keep the vendored router free of an import-time dependency on our package.
+        from moe_congestion_routing.metrics.swapgap import SWAPGAP_COSTS, swapgap
+
+        num_layers = self.config.num_layers
+        with torch.no_grad():
+            for cost in SWAPGAP_COSTS:
+                value = swapgap(logits, routing_map, cost, lam=1.0)
+                get_moe_metrics_tracker().record(
+                    f"swapgap_{cost}", value, self.layer_number, num_layers
+                )
+
+    def _record_phi_cong(self, routing_map: torch.Tensor):
+        """Record the discrete Rosenthal congestion potential, for every arm.
+
+        Fixed at lambda=1 for both cost families so that arms trained at different lambdas stay
+        comparable on one series. phi_cong_quadratic is therefore NOT the potential a quadratic
+        arm trains against, whose slope-matched default is lambda=0.5. The two differ by a
+        constant factor, so the discretization-gap identity does not hold between the logged
+        series for that arm.
+
+        Counts come from routing_map, the post-drop map routing() returns, reduced over
+        tp_cp_group. with_padding_mask stays False, unlike _apply_aux_loss; both are inert here,
+        since no arm in this project sets a padding mask or a capacity factor.
+        """
+        if not (self.training and torch.is_grad_enabled()):
+            return
+        if routing_map.shape[0] == 0:
+            return
+        # Local import: keep the vendored router free of an import-time dependency on our package.
+        from moe_congestion_routing.losses.rosenthal import COST_FAMILIES, congestion_potential
+
+        num_layers = self.config.num_layers
+        with torch.no_grad():
+            tokens_per_expert, _local_num_tokens, total_num_tokens = (
+                get_tokens_per_expert_and_token_count(
+                    routing_map=routing_map,
+                    reduce_group=self.tp_cp_group,
+                    topk=self.topk,
+                )
+            )
+            for cost_family in COST_FAMILIES:
+                value = congestion_potential(
+                    tokens_per_expert,
+                    total_num_tokens,
+                    self.topk,
+                    self.config.num_moe_experts,
+                    lam=1.0,
+                    cost_family=cost_family,
+                )
+                get_moe_metrics_tracker().record(
+                    f"phi_cong_{cost_family}", value, self.layer_number, num_layers
+                )
+
     def reset_global_aux_loss_tracker(self):
         """Reset the global aux loss tracker."""
         if self.global_tokens_per_expert is not None:
diff --git a/megatron/training/training.py b/megatron/training/training.py
index 3930cc46a..ebc2314e0 100644
--- a/megatron/training/training.py
+++ b/megatron/training/training.py
@@ -2549,6 +2549,12 @@ def training_log(
         if args.moe_z_loss_coeff is not None:
             track_names.append("z_loss")
 
+        # MoE metrics battery (patch). The names come from our own package rather than a literal
+        # list here, so adding a logged metric no longer means editing this vendored file.
+        from moe_congestion_routing.metrics.track_names import moe_track_names
+
+        track_names += moe_track_names(args)
+
         if is_hybrid_model(args):
             from operator import itemgetter
 
