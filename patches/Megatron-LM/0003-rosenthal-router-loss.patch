-                            "seq_aux_loss, global_aux_loss or none load balancing"
+                            "seq_aux_loss, global_aux_loss, rosenthal, global_rosenthal or none "
+                            "load balancing"
                         )
             elif self.moe_router_load_balancing_type not in [
                 "aux_loss",
                 "seq_aux_loss",
                 "global_aux_loss",
+                *ROSENTHAL_TYPES,
                 "none",
             ]:
                 raise ValueError(
                     "moe_expert_capacity_factor only works with aux_loss, "
-                    "seq_aux_loss, global_aux_loss or none load balancing"
+                    "seq_aux_loss, global_aux_loss, rosenthal, global_rosenthal or none load "
+                    "balancing"
+                )
+
+        # Rosenthal congestion loss validation (moe_congestion_routing patch). Deliberately
+        # duplicated in pretrain_config.py's build_megatron_args, which fails at --dry-run and so
+        # saves cluster queue time. This copy is the one no launch path can bypass.
+        #
+        # moe_router_load_balancing_type is a string or a list of strings, since Megatron supports
+        # combining balancing losses, so a bare equality check would let a list selecting rosenthal
+        # alongside another type skip every rule below. Rule 4 in particular has no other backstop.
+        if self.num_moe_experts is not None:
+            # Local import, gated so a dense-only config construction stays free of a dependency
+            # on our package. selected_rosenthal_types owns the scalar/list normalization, so this
+            # file does not repeat it.
+            from moe_congestion_routing.metrics.track_names import selected_rosenthal_types
+
+            _rosenthal_types_selected = selected_rosenthal_types(self)
+        else:
+            _rosenthal_types_selected = []
+
+        if len(_rosenthal_types_selected) > 1:
+            # _apply_rosenthal_loss resolves the two by which coefficient is nonzero, checking
+            # "rosenthal" first, so a list selecting both would silently drop the global one.
+            # Enforce here what that resolution assumes.
+            raise ValueError(
+                "moe_router_load_balancing_type selects more than one rosenthal type "
+                f"({_rosenthal_types_selected!r}) -- 'rosenthal' and 'global_rosenthal' are "
+                "mutually exclusive"
+            )
+
+        if _rosenthal_types_selected:
+            # Local import, reached only for a rosenthal balancing type. cost_families.py imports
+            # no torch, so this costs nothing on a login node.
+            from moe_congestion_routing.losses.cost_families import (
+                COST_FAMILIES,
+                VARIANTS,
+                cost_exponent,
+                pressure_bound,
+            )
+
+            if self.moe_rosenthal_variant not in VARIANTS:
+                raise ValueError(
+                    f"moe_rosenthal_variant must be one of {VARIANTS}, got "
+                    f"{self.moe_rosenthal_variant!r}"
+                )
+            if self.moe_rosenthal_cost not in COST_FAMILIES:
+                raise ValueError(
+                    f"moe_rosenthal_cost must be one of {COST_FAMILIES}, got "
+                    f"{self.moe_rosenthal_cost!r}"
+                )
+            if self.moe_rosenthal_lambda <= 0:
+                raise ValueError(
+                    f"moe_rosenthal_lambda must be > 0, got {self.moe_rosenthal_lambda}"
+                )
