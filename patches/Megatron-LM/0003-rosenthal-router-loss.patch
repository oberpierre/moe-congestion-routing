+    def _apply_rosenthal_loss(
+        self,
+        probs: torch.Tensor,
+        scores_for_aux_loss: torch.Tensor,
+        routing_map: torch.Tensor,
+        with_padding_mask: bool = False,
+    ):
+        """Apply the Rosenthal congestion loss (moe_congestion_routing patch).
+
+        Mirrors _apply_aux_loss and _apply_global_aux_loss. "rosenthal" reduces over tp_cp_group
+        and is stateless; "global_rosenthal" reduces over tp_dp_cp_group and averages across
+        grad-accumulation steps in its own three attributes, which are a second copy of
+        _apply_global_aux_loss's protocol rather than a share of its buffers. See __init__ above
+        for why they cannot be shared.
+
+        The router never all-reduces a differentiable tensor. Only the detached prob_sum is
+        reduced, and it is handed to rosenthal_loss as a synced coefficient multiplying a local
+        differentiable carrier, which is exact at any reduce-group size. All the math lives in
+        moe_congestion_routing.losses.rosenthal; nothing here restates a formula.
+        """
+        rosenthal_coeff = self.get_aux_loss_coeff("rosenthal")
+        is_global = False
+        if rosenthal_coeff == 0:
+            rosenthal_coeff = self.get_aux_loss_coeff("global_rosenthal")
+            is_global = True
+        if rosenthal_coeff == 0:
+            return probs
+
+        reduce_group = self.tp_dp_cp_group if is_global else self.tp_cp_group
+
+        # One fused all-reduce rather than get_tokens_per_expert_and_token_count plus a separate
+        # reduce for prob_sum. Counts and prob_sum must cover the same pre-drop token set, which a
+        # single joint reduce guarantees by construction. Both halves are detached statistics, so
+        # the identity backward is never exercised; the router's gradient flows through the local,
+        # undetached scores_for_aux_loss passed to rosenthal_loss below.
+        local_tokens_per_expert = routing_map.sum(dim=0).float()
+        local_prob_sum = scores_for_aux_loss.float().sum(dim=0).detach()
+        fused_local = torch.cat([local_tokens_per_expert, local_prob_sum])
+        fused_global = reduce_from_tensor_model_parallel_region(fused_local, reduce_group)
+        global_tokens_per_expert, global_prob_sum = fused_global.chunk(2)
+        if with_padding_mask:
+            local_num_tokens = local_tokens_per_expert.sum() / self.topk
+            total_num_tokens = global_tokens_per_expert.sum() / self.topk
+        else:
+            local_num_tokens = routing_map.shape[0]
+            total_num_tokens = local_num_tokens * reduce_group.size()
+
+        if is_global:
