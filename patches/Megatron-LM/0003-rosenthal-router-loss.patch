+            from moe_congestion_routing.metrics.track_names import selected_rosenthal_types
+
+            _is_single_balancing_type = (
+                not isinstance(self.moe_router_load_balancing_type, list)
+                or len(self.moe_router_load_balancing_type) == 1
+            )
+            if not (_is_single_balancing_type and len(selected_rosenthal_types(self)) == 1):
+                raise ValueError(
+                    "moe_rosenthal_log_grad_ratio requires moe_router_load_balancing_type to be "
+                    "EXACTLY 'rosenthal' or 'global_rosenthal' (not combined with any other "
+                    f"balancing type via the list form), got {self.moe_router_load_balancing_type!r}"
                 )
 
         if self.moe_pad_expert_input_to_capacity:
