+                raise ValueError(
+                    "a rosenthal balancing type requires moe_router_score_function == 'softmax' "
+                    "(sigmoid needs mean-centering to define the congestion loss, which is out "
+                    f"of scope), got {self.moe_router_score_function!r}"
+                )
