@@ -1618,6 +1624,35 @@ class TransformerConfig(ModelParallelConfig):
                         "moe_aux_loss_coeff are what you intend."
                     )
 
+        # Bias-update-rule validation (moe_congestion_routing patch), outside the rosenthal-loss
+        # branch above on purpose: this arm's moe_router_load_balancing_type is typically "none",
+        # so _rosenthal_types_selected is empty and none of the checks above ever run for it.
+        if self.moe_router_bias_update_rule not in ("sign", "rosenthal_price"):
+            raise ValueError(
+                "moe_router_bias_update_rule must be 'sign' or 'rosenthal_price', got "
+                f"{self.moe_router_bias_update_rule!r}"
+            )
+        if self.moe_router_bias_update_rule == "rosenthal_price":
+            if not self.moe_router_enable_expert_bias:
+                raise ValueError(
+                    "moe_router_bias_update_rule='rosenthal_price' requires "
+                    "moe_router_enable_expert_bias=True, otherwise finalize_model_grads.py skips "
+                    "the whole bias updater and the rule silently trains a plain control"
+                )
+            # Local import, reusing the same function-local shape as the rosenthal-loss checks
+            # above rather than importing at module load time.
+            from moe_congestion_routing.losses.cost_families import COST_FAMILIES
+
+            if self.moe_rosenthal_cost not in COST_FAMILIES:
+                raise ValueError(
+                    f"moe_rosenthal_cost must be one of {COST_FAMILIES}, got "
+                    f"{self.moe_rosenthal_cost!r}"
+                )
+            if self.moe_rosenthal_lambda <= 0:
+                raise ValueError(
+                    f"moe_rosenthal_lambda must be > 0, got {self.moe_rosenthal_lambda}"
+                )
+
         # Outside the rosenthal branch on purpose, because it catches a stray flag on a run that
         # is NOT rosenthal. Exactly one type, not merely including one, because the "cg" probe
         # wraps the single logits tensor every aux loss reads, so a mixed list would report their
